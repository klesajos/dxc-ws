{
  "extraKnownMarketplaces": {
    "dxc-ws": {
      "source": {
        "source": "github",
        "repo": "klesajos/dxc-ws"
      }
    }
  },
  "enabledPlugins": {
    "2048-dev@dxc-ws": true
  },
  "permissions": {
    "allow": [
      "Bash(cmake *)",
      "Bash(ctest *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(build/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-cpp.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/run-tests.sh"
          }
        ]
      }
    ]
  }
}
